# Postgres connection string used by Prisma (see prisma/schema.prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/carf?schema=public"

# GitHub App credentials — see core-api/src/adapters/github/README.md for the
# App manifest/permissions needed to register these (issue #16).
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Fastify server port.
PORT="3001"

# Only required when .carf.yml configures adapter.kind: "gitops" (see
# src/adapters/gitops.ts). Argo CD API base URL + a token with permission to read
# application status/history and trigger rollbacks.
ARGOCD_BASE_URL=""
ARGOCD_AUTH_TOKEN=""
