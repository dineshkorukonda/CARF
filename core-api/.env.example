# Postgres connection string used by Prisma (see prisma/schema.prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/carf?schema=public"

# GitHub App credentials — see core-api/src/adapters/github/README.md for the
# App manifest/permissions needed to register these (issue #16).
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""
GITHUB_WEBHOOK_SECRET=""

# Fastify server port.
PORT="3001"
