// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Dashboard & Authentication Models (Auth.js v5 @auth/prisma-adapter & Tenancy)
// -----------------------------------------------------------------------------

model User {
  id            String         @id @default(cuid())
  name          String?
  email         String?        @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  accounts      Account[]
  sessions      Session[]
  installations Installation[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// A GitHub App installation, linked back to the User that installed it. `installationId`
// is the tenancy key core-api's Commit/ChangeVector/Threshold/RolloutOutcome rows are scoped by.
model Installation {
  id                  String   @id @default(cuid())
  installationId      String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId              String
  targetLogin         String
  targetType          String
  repositorySelection String?
  // core-api's per-installation bearer credential (issue #65), fetched lazily on first
  // use of the status view (#64) via GET /v1/installations/:id/api-key and cached here.
  coreApiKey          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
}

// -----------------------------------------------------------------------------
// Core-API Rollout & Classification Models
// -----------------------------------------------------------------------------

model Commit {
  id              String           @id @default(cuid())
  owner           String
  repo            String
  sha             String
  baseSha         String
  installationId  String?
  changeVector    ChangeVector?
  threshold       Threshold?
  riskProfile     RiskProfile?
  rolloutOutcomes RolloutOutcome[]
  createdAt       DateTime         @default(now())

  @@unique([owner, repo, sha])
  @@index([owner, repo])
  @@index([installationId])
  @@index([installationId, createdAt])
}

// Mirrors the ChangeVector shape from core-api/src/classifier/vector.ts.
// A commit with no ChangeVector row means classifyCommit() returned null (no-op) for it.
model ChangeVector {
  id             String   @id @default(cuid())
  commit         Commit   @relation(fields: [commitId], references: [id], onDelete: Cascade)
  commitId       String   @unique
  infra          Float
  dependency     Float
  config         Float
  code           Float
  data           Float    @default(0)
  codeComplexity Float
  computedAt     DateTime @default(now())
}

// Output of the threshold engine (#11): the final rollback threshold/window computed
// for a commit from its ChangeVector. 1:1 with Commit, same relation style as ChangeVector.
model Threshold {
  id             String   @id @default(cuid())
  commit         Commit   @relation(fields: [commitId], references: [id], onDelete: Cascade)
  commitId       String   @unique
  baseThreshold  Float?
  finalThreshold Float
  baseWindow     Int?
  finalWindow    Int
  activeTypes    String[] @default([])
  computedAt     DateTime @default(now())
}

// Risk-matrix classification flags and multiplier.
model RiskProfile {
  id                String   @id @default(cuid())
  commitId          String   @unique
  commit            Commit   @relation(fields: [commitId], references: [id], onDelete: Cascade)
  flags             String[]
  multiplier        Float
  calibratedCeiling Float
}

// Ephemeral evaluation run result comparing Condition A vs. Condition B.
model EvalRun {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  iterations Int
  summary    Json
}

// Durable replacement for webhookOrchestrator.ts's old in-memory `activeLoops` Set (see
// issue #56): guards against a second core-api instance starting a concurrent Standalone
// rollback loop for the same commit.
model StandaloneLoopLock {
  id          String   @id @default(cuid())
  owner       String
  repo        String
  sha         String
  heartbeatAt DateTime @default(now())

  @@unique([owner, repo, sha])
}

enum RolloutStatus {
  PENDING
  SUCCESS
  ROLLED_BACK
  FAILED
}

enum RolloutTrigger {
  auto
  manual
}

enum DeploymentMode {
  standalone
  augment
}

// Records the lifecycle and outcome of a live Standalone rollback loop for a commit.
// Created as PENDING on processCommit success, then driven to terminal status (SUCCESS,
// ROLLED_BACK, or FAILED) by the background monitor worker.
model RolloutOutcome {
  id               String          @id @default(cuid())
  commit           Commit?         @relation(fields: [commitId], references: [id], onDelete: Cascade)
  commitId         String?
  owner            String?
  repo             String?
  commitSha        String
  installationId   String?
  trigger          RolloutTrigger  @default(auto)
  status           RolloutStatus   @default(PENDING)
  readyAt          DateTime?
  threshold        Float
  window           Int
  startedAt        DateTime        @default(now())
  finishedAt       DateTime?
  finalErrorRate   Float?
  rolledBack       Boolean         @default(false)
  reason           String?
  rollbackVerified Boolean?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @default(now()) @updatedAt
  samples          RolloutSample[]

  @@unique([installationId, commitSha])
  @@index([commitId])
  @@index([installationId])
  @@index([status])
}

// Intermediate health probe sample written by the monitor on every polling interval.
// Retained for high-resolution analytics (default 30-day retention).
model RolloutSample {
  id        String         @id @default(cuid())
  rolloutId String
  rollout   RolloutOutcome @relation(fields: [rolloutId], references: [id], onDelete: Cascade)
  ts        DateTime       @default(now())
  errorRate Float
  perTarget Json?

  @@index([rolloutId, ts])
  @@index([ts])
}

// Stores repository connection state, verification report, pause toggle, and fallback config.
// Rule: .carf.yml in the repository root strictly takes precedence over storedConfig when present.
model RepoConnection {
  id                    String         @id @default(cuid())
  installationId        String
  owner                 String
  repo                  String
  mode                  DeploymentMode @default(standalone)
  deploymentIntegration String?        @default("github_actions")
  runtimeAdapter        String?        @default("none")
  pm2Process            String?
  verifiedAt            DateTime?
  verificationReport    Json?
  monitoringPaused      Boolean        @default(false)
  storedConfig          Json?
  installTokenHash      String?
  installTokenPrefix    String?
  agentLastHeartbeat    DateTime?
  agentVersion          String?
  agentRevoked          Boolean?       @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([installationId, owner, repo])
  @@index([installationId])
  @@index([installTokenHash])
}

// Audit trail for administrative actions (manual rollback, pause monitoring, config edits).
model RolloutAuditLog {
  id        String   @id @default(cuid())
  actor     String
  owner     String
  repo      String
  rolloutId String?
  action    String
  result    String
  details   Json?
  ts        DateTime @default(now())

  @@index([owner, repo, ts])
  @@index([rolloutId])
}

// Bearer credential proving a caller acts on behalf of a given GitHub App installation --
// issue #65's decided auth mechanism for scoping dashboard-facing/authenticated reads
// (e.g. GET /v1/threshold) to that installation's own data.
model InstallationApiKey {
  id             String   @id @default(cuid())
  installationId String   @unique
  keyHash        String   @unique
  createdAt      DateTime @default(now())
}

// Records the outcome of an evaluation run (baseline vs. carf condition) for a given
// commit SHA. Deliberately not FK-related to Commit — evaluation runs may reference
// commits from historical/synthetic datasets that don't have a Commit row.
model EvaluationLog {
  id        String   @id @default(cuid())
  commitSha String
  condition String
  outcome   String
  mttrMs    Int?
  createdAt DateTime @default(now())

  @@index([commitSha])
  @@index([condition])
}

// Per-repository Augment integration state (e.g. GitHub Actions auto-integration).
// Additive: never stores secrets -- only safe metadata about the generated workflow.
model RepoIntegration {
  id              String    @id @default(cuid())
  installationId  String
  owner           String
  repo            String
  integration     String
  status          String    @default("not_configured")
  branch          String?
  workflowPath    String?
  workflowVersion Int?
  configuredAt    DateTime?
  lastVerifiedAt  DateTime?
  lastSyncAt      DateTime?
  lastPolicyAt    DateTime?
  lastCommitSha   String?
  lastError       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([installationId, owner, repo, integration])
  @@index([installationId])
}
