// Phase 1 note: this schema is wired up now so Phase 2 (#10, #11) doesn't require a
// rewrite, but nothing in Phase 1 persists to it yet — classifyCommit() stays pure.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Commit {
  id              String           @id @default(cuid())
  owner           String
  repo            String
  sha             String
  baseSha         String
  installationId  String?
  changeVector    ChangeVector?
  threshold       Threshold?
  rolloutOutcomes RolloutOutcome[]
  createdAt       DateTime         @default(now())

  @@unique([owner, repo, sha])
  @@index([owner, repo])
  @@index([installationId])
  @@index([installationId, createdAt])
}

// Mirrors the ChangeVector shape from core-api/src/classifier/vector.ts.
// A commit with no ChangeVector row means classifyCommit() returned null (no-op) for it.
model ChangeVector {
  id              String   @id @default(cuid())
  commit          Commit   @relation(fields: [commitId], references: [id], onDelete: Cascade)
  commitId        String   @unique
  infra           Float
  dependency      Float
  config          Float
  code            Float
  data            Float    @default(0)
  codeComplexity  Float
  computedAt      DateTime @default(now())
}

// Output of the threshold engine (#11): the final rollback threshold/window computed
// for a commit from its ChangeVector. 1:1 with Commit, same relation style as ChangeVector.
model Threshold {
  id             String   @id @default(cuid())
  commit         Commit   @relation(fields: [commitId], references: [id], onDelete: Cascade)
  commitId       String   @unique
  finalThreshold Float
  finalWindow    Int
  // The ChangeType names (see src/threshold/engine.ts) that contributed to
  // finalThreshold/finalWindow, i.e. ThresholdResult.activeTypes from computeThreshold().
  // Added for #12 (GET /v1/threshold) so the webhook API can return it without
  // recomputing from ChangeVector.
  activeTypes    String[] @default([])
  computedAt     DateTime @default(now())
}

// Durable replacement for webhookOrchestrator.ts's old in-memory `activeLoops` Set (see
// issue #56): guards against a second core-api instance starting a concurrent Standalone
// rollback loop for the same commit. `heartbeatAt` is renewed periodically by the
// lock-holding instance while its loop runs; a lock whose heartbeat has gone stale (holder
// crashed without releasing) is reclaimable by another instance rather than blocking that
// commit's redeliveries forever.
model StandaloneLoopLock {
  id          String   @id @default(cuid())
  owner       String
  repo        String
  sha         String
  heartbeatAt DateTime @default(now())

  @@unique([owner, repo, sha])
}

// Records what actually happened during a live Standalone rollback loop for a commit --
// as opposed to Threshold, which records what CARF *decided* the threshold/window should
// be. One row per runStandaloneLoop() completion (not unique per commit: a redelivery
// after a reclaimed lock could in principle run the loop again). Scoped by installationId
// from day one (issue #65's "don't build telemetry without tenant scoping, or it becomes
// a data-isolation retrofit" requirement) even though no query endpoint over this table
// exists yet -- see issue #54's design note on why the query side is deliberately deferred
// until a real caller-auth mechanism (issue #61) exists.
model RolloutOutcome {
  id             String   @id @default(cuid())
  commit         Commit   @relation(fields: [commitId], references: [id], onDelete: Cascade)
  commitId       String
  installationId String?
  rolledBack     Boolean
  finalErrorRate Float
  durationMs     Int
  createdAt      DateTime @default(now())

  @@index([commitId])
  @@index([installationId])
}

// Bearer credential proving a caller acts on behalf of a given GitHub App installation --
// issue #65's decided auth mechanism for scoping dashboard-facing/authenticated reads
// (e.g. GET /v1/threshold) to that installation's own data. One row per installationId
// (auto-created the first time a webhook arrives for it -- see
// src/auth/installationApiKeyService.ts); `keyHash` is a SHA-256 digest, never the
// plaintext key itself, which is shown to the operator exactly once (in the server log)
// at creation time and cannot be recovered afterward.
model InstallationApiKey {
  id             String   @id @default(cuid())
  installationId String   @unique
  keyHash        String   @unique
  createdAt      DateTime @default(now())
}

// Records the outcome of an evaluation run (baseline vs. carf condition) for a given
// commit SHA. Deliberately not FK-related to Commit — evaluation runs may reference
// commits from historical/synthetic datasets that don't have a Commit row.
model EvaluationLog {
  id        String   @id @default(cuid())
  commitSha String
  condition String
  outcome   String
  mttrMs    Int?
  createdAt DateTime @default(now())

  @@index([commitSha])
  @@index([condition])
}
