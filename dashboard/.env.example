# Public origin the dashboard is served from (no trailing slash). Used to build the OAuth
# and GitHub App install-flow redirect URIs -- must exactly match what's registered with
# GitHub, e.g. http://localhost:3000 in dev, https://dashboard.carf.indevs.in in prod.
DASHBOARD_BASE_URL="http://localhost:3000"

# Neon PostgreSQL connection string (pooled runtime connection)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/carf_dashboard?sslmode=require"

# Neon direct connection string (unpooled, required for Prisma migrations)
DIRECT_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/carf_dashboard?sslmode=require"

# Auth.js / NextAuth secret for encrypting JWT session cookies. Generate with `openssl rand -hex 32` or `npx auth secret`.
AUTH_SECRET=""

# GitHub App OAuth Client Credentials (found under GitHub App Settings -> General -> Client secrets)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# The CARF GitHub App (same App core-api's webhook/installation-token flow already uses --
# see core-api/.env.example). GITHUB_APP_SLUG is just the slug, e.g. "carf-cp" -- NOT the
# full "https://github.com/apps/carf-cp" URL (a full URL/link also works, it gets trimmed
# down automatically, but plain "carf-cp" is what's actually used). Its "Setup URL
# (optional)" must be set to "$DASHBOARD_BASE_URL/api/github-app/install/callback" with
# "Redirect on update" enabled.
GITHUB_APP_SLUG="carf-cp"
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# Base URL of the core-api instance this dashboard reads live status from --
# no trailing slash, e.g. http://localhost:3001 in dev, https://api.carf.indevs.in in prod.
CORE_API_BASE_URL="http://localhost:3001"

