# Public origin the dashboard is served from (no trailing slash). Used to build the OAuth
# and GitHub App install-flow redirect URIs -- must exactly match what's registered with
# GitHub, e.g. http://localhost:3002 in dev, https://dashboard.carf.dev in prod.
DASHBOARD_BASE_URL="http://localhost:3002"

# Shares the Postgres instance core-api uses if you like (distinct table names, no
# collision -- see prisma/schema.prisma), or point at a dedicated database.
DATABASE_URL="postgresql://user:password@localhost:5432/carf_dashboard"

# HMAC secret signing the session cookie. Generate with e.g. `openssl rand -hex 32`.
# Rotating it logs every signed-in user out.
SESSION_SECRET=""

# The CARF GitHub App (same App core-api's webhook/installation-token flow already uses --
# see core-api/.env.example). GITHUB_APP_SLUG is just the slug, e.g. "carf-cp" -- NOT the
# full "https://github.com/apps/carf-cp" URL (a full URL/link also works, it gets trimmed
# down automatically, but plain "carf-cp" is what's actually used). Its "Setup URL
# (optional)" must be set to "$DASHBOARD_BASE_URL/api/github-app/install/callback" with
# "Redirect on update" enabled.
GITHUB_APP_SLUG="carf-cp"
GITHUB_APP_ID=""
GITHUB_APP_PRIVATE_KEY=""

# Base URL of the core-api instance this dashboard reads live status from (issue #64) --
# no trailing slash, e.g. http://localhost:3001 in dev.
CORE_API_BASE_URL="http://localhost:3001"
