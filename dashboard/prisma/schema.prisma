// Dashboard's own tenancy tables -- distinct from core-api's schema.prisma but able to
// share the same Postgres instance (model names Account/Installation don't collide with
// core-api's Commit/ChangeVector/Threshold/etc.). See issue #61.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A dashboard user, authenticated with the dashboard's own email/password -- separate
// from the CARF GitHub App installation, which is authorized independently (see
// Installation below) and isn't tied to a specific human signer-in.
model Account {
  id                  String                @id @default(cuid())
  email               String                @unique
  passwordHash        String
  installations       Installation[]
  passwordResetTokens PasswordResetToken[]
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
}

// A "forgot password" request. Only a SHA-256 hash of the token is stored (never the raw
// value, same reasoning as Account.passwordHash) -- the raw token only ever exists in the
// emailed link and the requester's memory. `usedAt` makes it single-use even though it's
// already within `expiresAt`, closing the replay window between send and click.
model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([accountId])
}

// A GitHub App installation, linked back to the Account that installed it. `installationId`
// is the tenancy key core-api's Commit/ChangeVector/Threshold/RolloutOutcome rows are (or
// will be, per issue #65) scoped by -- this table is where that id first gets minted a
// real owner.
model Installation {
  id                   String   @id @default(cuid())
  installationId       String   @unique
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  accountId            String
  targetLogin          String
  targetType           String
  repositorySelection  String
  // core-api's per-installation bearer credential (issue #65), fetched lazily on first
  // use of the status view (#64) via GET /v1/installations/:id/api-key and cached here --
  // core-api only ever stores a hash, so this is the one place the plaintext lives
  // long-term. Re-fetched (rotating the old one) if ever lost/cleared.
  coreApiKey           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([accountId])
}
